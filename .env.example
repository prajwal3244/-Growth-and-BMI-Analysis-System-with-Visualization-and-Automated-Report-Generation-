# ---- Application ----
GROWTHAI_APP_NAME=GrowthAI
GROWTHAI_ENV=development           # development | production
GROWTHAI_LOG_LEVEL=INFO

# ---- Security ----
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
GROWTHAI_SECRET_KEY=change-me-in-production
GROWTHAI_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Database ----
# SQLite (dev, default):
GROWTHAI_DATABASE_URL=sqlite:///./growthai.db
# PostgreSQL (prod) example:
# GROWTHAI_DATABASE_URL=postgresql+psycopg2://user:pass@db:5432/growthai

# ---- Reference standard ----
GROWTHAI_DEFAULT_STANDARD=WHO      # WHO | CDC | IAP

# ---- Chatbot (optional hosted LLM; offline RAG works without any of these) ----
GROWTHAI_LLM_PROVIDER=offline      # offline | openai | gemini
GROWTHAI_OPENAI_API_KEY=
GROWTHAI_GEMINI_API_KEY=
